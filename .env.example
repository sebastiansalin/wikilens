# Optional persistent MariaDB backend. Without these, the app explicitly uses live Wikipedia.
# Create the database and an app user first; never use production credentials for this prototype.
MARIADB_HOST=
MARIADB_PORT=3307
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=wikilens
MARIADB_SSL=false
API_PORT=8787
